#!/usr/bin/env bash
set -euo pipefail

plugin=vip-block-data-api.php
header_pattern='^([[:space:]]*\* Version: )([^[:space:]]+)([[:space:]]*)$'
constant_pattern="^([[:space:]]*define\( 'WPCOMVIP__BLOCK_DATA_API__PLUGIN_VERSION', ')([^']+)(' \);[[:space:]]*)$"
version=$(sed -nE "s/$header_pattern/\2/p" "$plugin")
defined_version=$(sed -nE "s/$constant_pattern/\2/p" "$plugin")
semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'

if [[ ! $version =~ $semver || $version != "$defined_version" ]]; then
  echo 'Expected matching stable major.minor.patch versions in the plugin header and constant' >&2
  exit 1
fi

IFS=. read -r major minor patch <<< "$version"
case "${1:-}" in
  patch) patch=$((patch + 1)) ;;
  minor) minor=$((minor + 1)); patch=0 ;;
  major) major=$((major + 1)); minor=0; patch=0 ;;
  *) echo 'Usage: bash bin/release patch|minor|major' >&2; exit 1 ;;
esac
next_version="$major.$minor.$patch"

if [[ $(git branch --show-current) != trunk ]] || ! git diff --quiet || ! git diff --cached --quiet; then
  echo 'Prepare releases from a clean trunk checkout' >&2
  exit 1
fi

git switch -c "release/v$next_version"
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT
sed -E "s/$header_pattern/\1${next_version}\3/;s/$constant_pattern/\1${next_version}\3/" \
  "$plugin" > "$temporary"
cat "$temporary" > "$plugin"

git commit -m "Release $next_version" -- "$plugin"
