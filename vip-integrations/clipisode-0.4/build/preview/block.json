{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clipisode/preview-flow",
  "title": "Clipisode Preview Flow",
  "category": "widgets",
  "icon": "format-video",
  "description": "Parent container for the clipisode preview page layout.",
  "attributes": {
    "outputId": {
      "type": "number",
      "default": 0
    }
  },
  "providesContext": {
    "clipisode/outputId": "outputId"
  },
  "supports": {
    "html": false,
    "multiple": false,
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}