{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clipisode/preview-element",
  "title": "Clipisode Preview Element",
  "category": "widgets",
  "icon": "screenoptions",
  "description": "A single preview page element. Content comes from the clipisode output; styles are editable.",
  "parent": [
    "clipisode/preview-flow"
  ],
  "usesContext": [
    "clipisode/outputId"
  ],
  "attributes": {
    "type": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "lineHeight": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}