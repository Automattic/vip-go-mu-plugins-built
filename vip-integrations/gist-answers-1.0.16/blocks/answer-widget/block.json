{
    "$schema": "https://wp.org",
    "apiVersion": 3,
    "name": "gist-answers/answer",
    "version": "1.0.16",
    "title": "Gist Answer Widget",
    "category": "gist-answers",
    "icon": "list-view",
    "description": "Displays a Gist Answer Widget.",
    "textdomain": "gist-answers",
	"editorScript": "wp-blocks",
    "attributes": {
        "widgetId": {
            "type": "string",
            "default": ""
        },
        "preview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "viewportWidth": 234,
        "attributes": {
            "preview": true
        }
    },
    "supports": {
        "html": false
    }
}
